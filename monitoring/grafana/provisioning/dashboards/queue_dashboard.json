{
  "title": "Smart Queue & Dwell-Time Telemetry",
  "uid": "smart-queue-live",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Active Customers in Queue",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "queue_active_customers", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 4 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Max Customer Dwell Time (s)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "queue_max_dwell_seconds", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 45 },
              { "color": "red", "value": 60 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "p95 Inference Latency (ms) [SLA < 75ms]",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(queue_inference_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency (ms)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Avg Detection Confidence (Drift Monitor)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "queue_avg_detection_confidence",
          "legendFormat": "Avg Confidence",
          "refId": "A"
        }
      ]
    }
  ]
}